{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "GSM.Core": "Debug",
        "GSM.Core.Source.Device": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/device-.txt",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": null,
          "shared": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/device-structured-.json",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": null,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProperty"
    ],
    "Properties": {
      "Application": "GSM.Core.Device",
      "Environment": "Development"
    }
  }
}
